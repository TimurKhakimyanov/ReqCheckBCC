# Zoe (ReqCheck) — настройки модели для CLI (python run.py / сервис cli). Веб-стек этот файл НЕ читает:
# в вебе ключи задаются в «Кабинете». Корневой .env — только секреты установки веб-стека.
#
# Скопируйте в data/cli.env (папка data/ в git не попадает) и раскомментируйте один блок:
#   Python: python run.py data/requirements.md data/report.pdf --env data/cli.env
#   Docker: docker compose -p reqcheck-core --profile cli run --rm --build cli /data/requirements.md /data/report.pdf --env /data/cli.env
# Флаги командной строки и переменные окружения важнее этого файла. Все переменные — docs/cli.md.

# --- Gemini (бесплатный ключ: https://aistudio.google.com/ → Get API key) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Бесплатный тариф: по одному запросу и пауза между ними
# LLM_CONCURRENCY=1
# LLM_MIN_INTERVAL=6

# --- OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=

# --- Anthropic ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# --- Свой OpenAI-совместимый сервер (vLLM, LM Studio), ключ не нужен ---
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://vllm.example.local:8000/v1
# OPENAI_MODEL=
# LLM_CONCURRENCY=4
# LLM_TIMEOUT=900
# LLM_MAX_TOKENS=48000
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# LLM_EXTRA_BODY_REVIEWER={"chat_template_kwargs":{"enable_thinking":true}}

# --- Ollama, ключ не нужен ---
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
