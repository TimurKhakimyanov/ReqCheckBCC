# Пример конфигурации ReqCheck. Скопируйте в .env и замените все change-me.
# .env никогда не коммитится. Разделы помечены сессией-владельцем; новые переменные — в свой раздел.

# ===================== Общие (Инфраструктура) =====================
# Профили: monitoring, offline, gpu (через запятую). test и cli включаются флагом --profile при запуске.
COMPOSE_PROFILES=monitoring
APP_ENV=production
LOG_LEVEL=INFO
# Порт веба на хосте; прокси и TLS настраиваются на хосте и смотрят сюда.
BIND_ADDR=127.0.0.1
WEB_PORT=8080
GRAFANA_PORT=3000
AGENT_VERSION=dev

# ===================== Безопасность и вход (Бэкенд) =====================
# Случайная строка от 32 символов — подпись JWT сессии.
APP_SECRET_KEY=change-me
# Ключ Fernet для шифрования API-ключей провайдеров в БД.
# Сгенерировать: docker compose run --rm --no-deps api python -m app.keygen
APP_ENCRYPTION_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
MAX_UPLOAD_MB=25
WORKER_CONCURRENCY=2

# ===================== Хранилища (Инфраструктура) =====================
POSTGRES_DB=reqcheck
POSTGRES_USER=reqcheck
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
QDRANT_API_KEY=change-me
# SeaweedFS (S3 API)
S3_ACCESS_KEY=reqcheck
S3_SECRET_KEY=change-me
S3_BUCKET=reqcheck
GRAFANA_ADMIN_PASSWORD=change-me

# ===================== LLM (Ядро) =====================
# В веб-интерфейсе ключи задаются в кабинете; эти значения нужны CLI и как начальные настройки.
# Провайдер: gemini | openai | anthropic | openai_compatible
LLM_PROVIDER=gemini
LLM_MODEL=
# Gemini — бесплатный ключ: https://aistudio.google.com/
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Локальная модель (Ollama/vLLM) через OpenAI-совместимый API
OPENAI_COMPATIBLE_BASE_URL=http://ollama:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# ===================== Эмбеддинги и локальная модель (Бэкенд / Инфраструктура) =====================
# local | gemini | openai
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
# Модели Ollama, скачиваемые при сборке профиля offline (через запятую)
OLLAMA_MODELS=
