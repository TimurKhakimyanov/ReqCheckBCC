# ReqCheck — настройки установки. Скопируйте в .env (в git не попадает).
# Здесь только то, что задаётся один раз: ключи, пароли, логины. Всё про ИИ (провайдеры, ключи API, модели,
# эмбеддинги, паузы и пакеты запросов) настраивается в веб-интерфейсе: «Администрирование».
#
# Пустые секреты заполнит генератор (меняет только пустые значения, остальное не трогает):
#   docker run --rm --user "$(id -u):$(id -g)" -v "$PWD:/work" -w /work alpine:3 sh deploy/secrets/generate.sh
#
# Пароли Postgres, Redis, Qdrant и ключи S3 применяются при первом запуске; менять их потом — см. docs/configuration.md.
# Расширенные переопределения (порты, сроки хранения, Ollama, бэкапы и т. п.) — тоже в docs/configuration.md.

# --- Приложение ---
# Подпись сессий (случайная строка от 32 символов) и ключ Fernet для шифрования API-ключей провайдеров в БД.
APP_SECRET_KEY=
APP_ENCRYPTION_KEY=
# Администратор веб-интерфейса
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Хранилища ---
POSTGRES_USER=reqcheck
POSTGRES_PASSWORD=
REDIS_PASSWORD=
QDRANT_API_KEY=
# SeaweedFS (S3 API)
S3_ACCESS_KEY=reqcheck
S3_SECRET_KEY=

# --- Мониторинг (Grafana) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Необязательно при установке ---
# Адрес и порты на хосте (наружу публикуются только веб и Grafana; TLS и прокси — на хосте).
# BIND_ADDR=127.0.0.1
# WEB_PORT=8080
# GRAFANA_PORT=3000
# Профили через запятую: monitoring — Prometheus/Grafana/Loki; offline ИЛИ gpu — локальная LLM (Ollama).
# COMPOSE_PROFILES=monitoring
