# Пример конфигурации ReqCheck. Скопируйте в .env и замените все change-me.
# .env никогда не коммитится. Разделы помечены сессией-владельцем; новые переменные — в свой раздел.

# ===================== Общие (Инфраструктура) =====================
# Профили через запятую: monitoring (Prometheus/Grafana/Loki), offline (Ollama на CPU) ИЛИ gpu (Ollama на NVIDIA).
# offline и gpu взаимоисключающие — включайте один. test, cli и backup включаются флагом --profile при запуске.
COMPOSE_PROFILES=monitoring
APP_ENV=production
LOG_LEVEL=INFO
# Адрес и порты на хосте. Наружу публикуются только web и grafana; прокси и TLS настраиваются на хосте
# (пример: deploy/nginx/host-example.conf). 0.0.0.0 — только если перед стеком нет своего прокси.
BIND_ADDR=127.0.0.1
WEB_PORT=8080
GRAFANA_PORT=3000
AGENT_VERSION=dev

# ===================== Безопасность и вход (Бэкенд) =====================
# Случайная строка от 32 символов — подпись JWT сессии.
APP_SECRET_KEY=change-me
# Ключ Fernet для шифрования API-ключей провайдеров в БД.
# Сгенерировать: docker compose run --rm --no-deps api python -m app.keygen
APP_ENCRYPTION_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
MAX_UPLOAD_MB=25
WORKER_CONCURRENCY=2
# Максимальная длительность одного прогона, с (дольше — прогон завершается с ошибкой)
RUN_TIMEOUT_S=1800
# Время жизни сессии входа, ч
SESSION_TTL_HOURS=12
# true, если веб открывается по HTTPS (cookie сессии с флагом Secure)
COOKIE_SECURE=false

# ===================== Хранилища (Инфраструктура) =====================
# Все change-me обязательно заменить. Сгенерировать секрет (без установки чего-либо на хост):
#   docker run --rm alpine:3 sh -c 'tr -dc A-Za-z0-9 < /dev/urandom | head -c 40; echo'
POSTGRES_DB=reqcheck
POSTGRES_USER=reqcheck
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
QDRANT_API_KEY=change-me
# SeaweedFS (S3 API): ключи попадают в s3.json при старте контейнера, бакет создаётся автоматически.
S3_ACCESS_KEY=reqcheck
S3_SECRET_KEY=change-me
S3_BUCKET=reqcheck
# Размер одного тома SeaweedFS, МБ (файлы складываются в тома этого размера).
SEAWEEDFS_VOLUME_SIZE_MB=1024
# Мониторинг (профиль monitoring)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Внешний адрес Grafana за прокси, например https://reqcheck.example.kz/grafana/ (пусто — http://localhost:3000)
GRAFANA_ROOT_URL=
# true — если Grafana отдаётся прокси по подпути (/grafana/), см. deploy/nginx/host-example.conf
GRAFANA_SERVE_FROM_SUB_PATH=false
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=5GB
LOKI_RETENTION=336h
# Бэкапы (профиль backup): сколько дней хранить каталоги в ./backups
BACKUP_KEEP_DAYS=14

# ===================== LLM (Ядро) =====================
# В веб-интерфейсе ключи задаются в кабинете; эти значения нужны CLI и как начальные настройки.
# Провайдер: gemini | openai | anthropic | openai_compatible
LLM_PROVIDER=gemini
LLM_MODEL=
# Gemini — бесплатный ключ: https://aistudio.google.com/
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Локальная модель (Ollama/vLLM) через OpenAI-совместимый API
OPENAI_COMPATIBLE_BASE_URL=http://ollama:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# Пауза между вызовами LLM, с (0 — без паузы). Для бесплатного Gemini при частых 429 поставьте 5–10.
LLM_MIN_INTERVAL_S=0
# Попыток на вызов при 429/5xx/сетевых ошибках (экспоненциальная задержка, учитывается retry-after)
LLM_MAX_ATTEMPTS=6
# Требований в одном запросе проверки; параллельных запросов (для платных ключей можно 3–4)
REQCHECK_BATCH_SIZE=6
REQCHECK_CONCURRENCY=1

# ===================== Эмбеддинги и локальная модель (Бэкенд / Инфраструктура) =====================
# local | gemini | openai
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
# Для gemini/openai: ключ (по умолчанию берётся GEMINI_API_KEY / OPENAI_API_KEY) и размерность Gemini.
# Смена провайдера или модели меняет размерность: коллекции Qdrant пересоздаются, база знаний переиндексируется при старте api.
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIM=768
# Модели Ollama, вшиваемые в образ при сборке профилей offline/gpu (через запятую), например qwen3:8b.
# Сборка с моделями требует интернета и места на диске; готовый образ работает без сети.
OLLAMA_MODELS=
# Лимит памяти контейнера Ollama (модель целиком в RAM на CPU-варианте), сколько держать модель в памяти,
# сколько запросов обрабатывать параллельно.
OLLAMA_MEM_LIMIT=16g
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=2
