{
  "$defs": {
    "CheckVerdict": {
      "enum": [
        "pass",
        "fail",
        "not_applicable"
      ],
      "title": "CheckVerdict",
      "type": "string"
    },
    "ChecklistAnswer": {
      "enum": [
        "yes",
        "no",
        "partial",
        "not_required"
      ],
      "title": "ChecklistAnswer",
      "type": "string"
    },
    "ChecklistItem": {
      "description": "Ответ агента на пункт чек-листа «Ревью требований» из шаблона документа (если он есть).",
      "properties": {
        "question": {
          "title": "Question",
          "type": "string"
        },
        "answer": {
          "$ref": "#/$defs/ChecklistAnswer"
        },
        "comment": {
          "title": "Comment",
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        }
      },
      "required": [
        "question",
        "answer",
        "comment"
      ],
      "title": "ChecklistItem",
      "type": "object"
    },
    "ClarifyingQuestion": {
      "description": "Уточняющий вопрос автору документа: закрытый, с вариантами ответа и ссылками на дефекты.",
      "properties": {
        "id": {
          "description": "Q-01, Q-02…",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "why": {
          "description": "Что заблокировано без ответа",
          "title": "Why",
          "type": "string"
        },
        "addressee": {
          "default": "Аналитик",
          "description": "Кто отвечает: Business owner, Product owner, Аналитик…",
          "title": "Addressee",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/QuestionPriority",
          "default": "important"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "options": {
          "description": "2–4 варианта ответа, между которыми выбирает автор",
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "requirement_ids": {
          "items": {
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ответ автора (если прогон запущен с ответами)",
          "title": "Answer"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuestionResolution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "question",
        "why"
      ],
      "title": "ClarifyingQuestion",
      "type": "object"
    },
    "Conclusion": {
      "properties": {
        "ready_for_development": {
          "title": "Ready For Development",
          "type": "boolean"
        },
        "ready_for_testing": {
          "title": "Ready For Testing",
          "type": "boolean"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "top_fixes": {
          "description": "Что исправить в первую очередь, по порядку; со ссылками на D-xxx",
          "items": {
            "type": "string"
          },
          "title": "Top Fixes",
          "type": "array"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decision"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Нельзя / можно с ограничениями / можно"
        },
        "development": {
          "default": "",
          "description": "Что можно брать в разработку сейчас, что заблокировано",
          "title": "Development",
          "type": "string"
        },
        "testing": {
          "default": "",
          "description": "По каким требованиям можно писать тест-кейсы",
          "title": "Testing",
          "type": "string"
        },
        "fixes": {
          "description": "top_fixes с обоснованием и ссылками",
          "items": {
            "$ref": "#/$defs/FixItem"
          },
          "title": "Fixes",
          "type": "array"
        },
        "strengths": {
          "description": "Сильные стороны документа",
          "items": {
            "type": "string"
          },
          "title": "Strengths",
          "type": "array"
        },
        "guard_note": {
          "default": "",
          "description": "Решение ужесточено правилом (например, есть критичные дефекты)",
          "title": "Guard Note",
          "type": "string"
        }
      },
      "required": [
        "ready_for_development",
        "ready_for_testing",
        "rationale",
        "top_fixes"
      ],
      "title": "Conclusion",
      "type": "object"
    },
    "Criterion": {
      "enum": [
        "necessary",
        "implementation_free",
        "unambiguous",
        "complete",
        "singular",
        "feasible",
        "verifiable",
        "correct",
        "conforming",
        "traceable",
        "set_complete",
        "set_consistent",
        "set_feasible",
        "set_comprehensible",
        "set_validatable",
        "set_ranked",
        "set_modifiable",
        "set_traceable"
      ],
      "title": "Criterion",
      "type": "string"
    },
    "CriterionCheck": {
      "properties": {
        "criterion": {
          "$ref": "#/$defs/Criterion"
        },
        "verdict": {
          "$ref": "#/$defs/CheckVerdict"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "assessed_by": {
          "description": "Кто оценил критерий набора (рецензенты)",
          "items": {
            "type": "string"
          },
          "title": "Assessed By",
          "type": "array"
        }
      },
      "required": [
        "criterion",
        "verdict"
      ],
      "title": "CriterionCheck",
      "type": "object"
    },
    "Decision": {
      "description": "Итоговое решение по документу.",
      "enum": [
        "blocked",
        "limited",
        "ready"
      ],
      "title": "Decision",
      "type": "string"
    },
    "DefectType": {
      "description": "Тип дефекта (методика bbc-agent). Первые три — «критичные» в терминах задания.",
      "enum": [
        "unverifiable",
        "contradictory",
        "incomplete",
        "ambiguous",
        "design",
        "not_singular",
        "infeasible",
        "incorrect",
        "nonconforming",
        "untraceable",
        "redundant",
        "risk"
      ],
      "title": "DefectType",
      "type": "string"
    },
    "DocumentFormat": {
      "enum": [
        "pdf",
        "docx",
        "md",
        "txt"
      ],
      "title": "DocumentFormat",
      "type": "string"
    },
    "Finding": {
      "properties": {
        "id": {
          "description": "D-001, D-002…",
          "title": "Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/FindingScope"
        },
        "requirement_ids": {
          "items": {
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        },
        "criterion": {
          "$ref": "#/$defs/Criterion"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "locations": {
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "minItems": 1,
          "title": "Locations",
          "type": "array"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Предлагаемая исправленная формулировка",
          "title": "Suggestion"
        },
        "source": {
          "$ref": "#/$defs/FindingSource",
          "default": "llm"
        },
        "defect_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/DefectType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "grounding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Grounding"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Лучшая привязка цитат замечания к тексту"
        },
        "found_by": {
          "description": "Агенты, нашедшие дефект (с учётом слитых дублей): inspector, reviewer:qa…",
          "items": {
            "type": "string"
          },
          "title": "Found By",
          "type": "array"
        },
        "verifier_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Обоснование решения верификатора",
          "title": "Verifier Note"
        },
        "resolved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Вопрос Q-xx, ответ на который снимает дефект",
          "title": "Resolved By"
        }
      },
      "required": [
        "id",
        "scope",
        "criterion",
        "severity",
        "title",
        "explanation",
        "locations"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingScope": {
      "enum": [
        "requirement",
        "set"
      ],
      "title": "FindingScope",
      "type": "string"
    },
    "FindingSource": {
      "enum": [
        "llm",
        "rule"
      ],
      "title": "FindingSource",
      "type": "string"
    },
    "FixItem": {
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "why": {
          "default": "",
          "title": "Why",
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        }
      },
      "required": [
        "action"
      ],
      "title": "FixItem",
      "type": "object"
    },
    "Grounding": {
      "description": "Насколько цитата замечания совпала с документом (проверено кодом).",
      "enum": [
        "exact",
        "fuzzy",
        "line"
      ],
      "title": "Grounding",
      "type": "string"
    },
    "ParsedDocument": {
      "description": "Нормализованный текст документа. Все смещения в отчёте считаются от `text`.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/DocumentFormat"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "page_offsets": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Смещение начала каждой страницы в `text` (только для PDF)",
          "title": "Page Offsets"
        }
      },
      "required": [
        "name",
        "format",
        "sha256",
        "text"
      ],
      "title": "ParsedDocument",
      "type": "object"
    },
    "QualityStats": {
      "description": "Контроль достоверности и покрытия прогона.",
      "properties": {
        "candidates": {
          "default": 0,
          "title": "Candidates",
          "type": "integer"
        },
        "rejected_by_code": {
          "default": 0,
          "title": "Rejected By Code",
          "type": "integer"
        },
        "rejected_by_verifier": {
          "default": 0,
          "title": "Rejected By Verifier",
          "type": "integer"
        },
        "merged": {
          "default": 0,
          "title": "Merged",
          "type": "integer"
        },
        "confirmed": {
          "default": 0,
          "title": "Confirmed",
          "type": "integer"
        },
        "unverified": {
          "default": 0,
          "title": "Unverified",
          "type": "integer"
        },
        "evidence_exact": {
          "default": 0,
          "title": "Evidence Exact",
          "type": "integer"
        },
        "evidence_fuzzy": {
          "default": 0,
          "title": "Evidence Fuzzy",
          "type": "integer"
        },
        "evidence_line": {
          "default": 0,
          "title": "Evidence Line",
          "type": "integer"
        },
        "inline_quotes_unverified": {
          "default": 0,
          "title": "Inline Quotes Unverified",
          "type": "integer"
        },
        "removed_refs": {
          "default": 0,
          "title": "Removed Refs",
          "type": "integer"
        },
        "matrix_cells_total": {
          "default": 0,
          "title": "Matrix Cells Total",
          "type": "integer"
        },
        "matrix_cells_filled": {
          "default": 0,
          "title": "Matrix Cells Filled",
          "type": "integer"
        },
        "rounds": {
          "default": 0,
          "title": "Rounds",
          "type": "integer"
        },
        "uncovered_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Uncovered Requirements",
          "type": "array"
        },
        "reviews_failed": {
          "items": {
            "type": "string"
          },
          "title": "Reviews Failed",
          "type": "array"
        },
        "extracted_first_pass": {
          "default": 0,
          "title": "Extracted First Pass",
          "type": "integer"
        },
        "extracted_by_coverage": {
          "default": 0,
          "title": "Extracted By Coverage",
          "type": "integer"
        },
        "context_window": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Window"
        },
        "context_peak_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Peak Pct"
        },
        "doc_parts": {
          "default": 1,
          "title": "Doc Parts",
          "type": "integer"
        },
        "prompt_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Prompt Versions",
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "QualityStats",
      "type": "object"
    },
    "QuestionPriority": {
      "enum": [
        "blocker",
        "important",
        "minor"
      ],
      "title": "QuestionPriority",
      "type": "string"
    },
    "QuestionResolution": {
      "description": "Что меняет ответ автора: новые редакции требований и снятые дефекты.",
      "properties": {
        "rewrites": {
          "items": {
            "$ref": "#/$defs/RequirementRewrite"
          },
          "title": "Rewrites",
          "type": "array"
        },
        "closes_findings": {
          "items": {
            "type": "string"
          },
          "title": "Closes Findings",
          "type": "array"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "title": "QuestionResolution",
      "type": "object"
    },
    "Requirement": {
      "properties": {
        "id": {
          "description": "Идентификатор в отчёте: R-001, R-002…; подтребования R-002.1",
          "title": "Id",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Идентификатор в документе (Ф-1), если был",
          "title": "Source Id"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Для атомарного подтребования — id составного",
          "title": "Parent Id"
        },
        "kind": {
          "$ref": "#/$defs/RequirementKind"
        },
        "summary": {
          "description": "Краткая формулировка для таблицы нарезки",
          "title": "Summary",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/SourceLocation"
        }
      },
      "required": [
        "id",
        "kind",
        "summary",
        "location"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "RequirementAssessment": {
      "properties": {
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CriterionCheck"
          },
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "requirement_id",
        "checks"
      ],
      "title": "RequirementAssessment",
      "type": "object"
    },
    "RequirementKind": {
      "enum": [
        "functional",
        "non_functional",
        "data",
        "integration",
        "api",
        "ui",
        "acceptance",
        "other"
      ],
      "title": "RequirementKind",
      "type": "string"
    },
    "RequirementRewrite": {
      "properties": {
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "new_text": {
          "title": "New Text",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "new_text"
      ],
      "title": "RequirementRewrite",
      "type": "object"
    },
    "RunPassport": {
      "properties": {
        "document_name": {
          "title": "Document Name",
          "type": "string"
        },
        "document_sha256": {
          "title": "Document Sha256",
          "type": "string"
        },
        "run_at": {
          "format": "date-time",
          "title": "Run At",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "agent_version": {
          "description": "git commit или тег агента",
          "title": "Agent Version",
          "type": "string"
        },
        "standards": {
          "items": {
            "type": "string"
          },
          "title": "Standards",
          "type": "array"
        }
      },
      "required": [
        "document_name",
        "document_sha256",
        "run_at",
        "provider",
        "model",
        "agent_version"
      ],
      "title": "RunPassport",
      "type": "object"
    },
    "SetAssessment": {
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CriterionCheck"
          },
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "checks"
      ],
      "title": "SetAssessment",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "major",
        "minor"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SkippedFragment": {
      "description": "Текст документа, который нарезчик не счёл требованием (контроль покрытия нарезки).",
      "properties": {
        "location": {
          "$ref": "#/$defs/SourceLocation"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "location",
        "reason"
      ],
      "title": "SkippedFragment",
      "type": "object"
    },
    "SourceLocation": {
      "description": "Ссылка на конкретное место документа. Каждое нарушение обязано иметь хотя бы одну.",
      "properties": {
        "section": {
          "description": "Путь раздела, напр. «Часть A › Функциональные требования»",
          "title": "Section",
          "type": "string"
        },
        "quote": {
          "description": "Дословная цитата из документа",
          "title": "Quote",
          "type": "string"
        },
        "char_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Смещение цитаты в ParsedDocument.text",
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Номер страницы с 1 (для PDF)",
          "title": "Page"
        },
        "verified": {
          "default": false,
          "description": "Цитата найдена в тексте документа кодом (защита от галлюцинаций)",
          "title": "Verified",
          "type": "boolean"
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
