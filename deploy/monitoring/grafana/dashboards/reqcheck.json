{
  "uid": "reqcheck",
  "title": "ReqCheck",
  "description": "API, прогоны агента, очередь Celery, токены и стоимость LLM, активность, эмбеддинги, ресурсы и логи. Имена метрик — docs/monitoring.md.",
  "tags": ["reqcheck"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Compose-проект",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(container_memory_working_set_bytes, container_label_com_docker_compose_project)", "refId": "project" },
        "definition": "label_values(container_memory_working_set_bytes, container_label_com_docker_compose_project)",
        "refresh": 2,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "service",
        "label": "Сервис (логи)",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "service", "stream": "", "type": 1 },
        "definition": "label_values(service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "Обзор", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    {
      "type": "stat", "title": "Доступность целей Prometheus",
      "description": "1 — цель отвечает на /metrics, 0 — недоступна. ollama в списке нет: у него нет метрик.",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "max by (job) (up)", "legendFormat": "{{job}}", "instant": true } ],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "name", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": {
        "mappings": [ { "type": "value", "options": { "0": { "text": "down" }, "1": { "text": "up" } } } ],
        "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
      } }
    },

    { "type": "row", "title": "API", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "panels": [] },
    {
      "type": "timeseries", "title": "Запросы API по статусу, rps",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (status) (rate(reqcheck_http_requests_total[$__rate_interval]))", "legendFormat": "{{status}}" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 30 } } }
    },
    {
      "type": "timeseries", "title": "Доля ошибок API (5xx и 4xx)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(reqcheck_http_requests_total{status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(reqcheck_http_requests_total[$__rate_interval])), 1e-9)", "legendFormat": "5xx" },
        { "refId": "B", "expr": "sum(rate(reqcheck_http_requests_total{status=~\"4..\"}[$__rate_interval])) / clamp_min(sum(rate(reqcheck_http_requests_total[$__rate_interval])), 1e-9)", "legendFormat": "4xx" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.05 } ] },
        "custom": { "thresholdsStyle": { "mode": "line" } } } }
    },
    {
      "type": "timeseries", "title": "Латентность API p95 по маршрутам",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(reqcheck_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{route}}" } ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    { "type": "row", "title": "Прогоны и очередь", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "panels": [] },
    {
      "type": "stat", "title": "Прогоны за период",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (status) (increase(reqcheck_worker_runs_total[$__range]))", "legendFormat": "{{status}}", "instant": true } ],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "failed" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "cancelled" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "done" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }
        ] }
    },
    {
      "type": "timeseries", "title": "Длительность прогона (p50 / p95)",
      "gridPos": { "h": 8, "w": 7, "x": 4, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(reqcheck_worker_run_duration_seconds_bucket{status=\"done\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(reqcheck_worker_run_duration_seconds_bucket{status=\"done\"}[$__rate_interval])))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries", "title": "Очередь Celery и прогоны в работе",
      "description": "Длина очереди reqcheck в Redis (redis-exporter) и число выполняющихся прогонов (воркер).",
      "gridPos": { "h": 8, "w": 6, "x": 11, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(redis_key_size{key=\"reqcheck\"})", "legendFormat": "в очереди" },
        { "refId": "B", "expr": "sum(reqcheck_worker_runs_in_progress)", "legendFormat": "в работе" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 } }
    },
    {
      "type": "bargauge", "title": "Дефекты за период по критичности",
      "gridPos": { "h": 8, "w": 7, "x": 17, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (severity) (increase(reqcheck_findings_total[$__range]))", "legendFormat": "{{severity}}", "instant": true } ],
      "options": { "orientation": "horizontal", "displayMode": "basic", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "critical" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "major" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "minor" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] }
        ] }
    },

    { "type": "row", "title": "LLM (прогоны)", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "panels": [] },
    {
      "type": "stat", "title": "Токены LLM за период",
      "description": "Учитываются по завершении прогона (usage провайдера). Токены чата не входят.",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (kind) (increase(reqcheck_llm_tokens_total[$__range]))", "legendFormat": "{{kind}}", "instant": true } ],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } }
    },
    {
      "type": "timeseries", "title": "Токены LLM в минуту по моделям",
      "gridPos": { "h": 8, "w": 8, "x": 4, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (provider, model, kind) (rate(reqcheck_llm_tokens_total[$__rate_interval])) * 60", "legendFormat": "{{provider}}/{{model}} {{kind}}" } ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 60 } } }
    },
    {
      "type": "timeseries", "title": "Вызовы LLM в минуту",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (provider, model) (rate(reqcheck_llm_calls_total[$__rate_interval])) * 60", "legendFormat": "{{provider}}/{{model}}" } ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 60 } } }
    },
    {
      "type": "stat", "title": "Стоимость LLM за период, USD",
      "description": "Оценка по тарифам из ядра; для локальной модели (openai_compatible) — 0.",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(reqcheck_llm_cost_usd_total[$__range]))", "legendFormat": "всего", "instant": true },
        { "refId": "B", "expr": "sum by (provider, model) (increase(reqcheck_llm_cost_usd_total[$__range]))", "legendFormat": "{{provider}}/{{model}}", "instant": true }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 } }
    },

    { "type": "row", "title": "Активность и поиск", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }, "panels": [] },
    {
      "type": "timeseries", "title": "Загрузки и запуски прогонов в час",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (format) (rate(reqcheck_documents_uploaded_total[$__rate_interval])) * 3600", "legendFormat": "загрузка {{format}}" },
        { "refId": "B", "expr": "sum by (provider) (rate(reqcheck_runs_created_total[$__rate_interval])) * 3600", "legendFormat": "прогон {{provider}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "timeseries", "title": "Входы и чат в час",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (rate(reqcheck_logins_total[$__rate_interval])) * 3600", "legendFormat": "вход {{result}}" },
        { "refId": "B", "expr": "sum by (provider, result) (rate(reqcheck_chat_messages_total[$__rate_interval])) * 3600", "legendFormat": "чат {{provider}} {{result}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" },
        "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*(failed|error).*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] }
    },
    {
      "type": "timeseries", "title": "Открытые SSE-потоки",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (kind) (reqcheck_sse_connections)", "legendFormat": "{{kind}}" } ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 } }
    },
    {
      "type": "timeseries", "title": "Эмбеддинги: тексты/с, p95, ошибки",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (kind) (rate(reqcheck_embedder_texts_total[$__rate_interval]))", "legendFormat": "тексты {{kind}}" },
        { "refId": "B", "expr": "sum(rate(reqcheck_embedder_errors_total[$__rate_interval]))", "legendFormat": "ошибки" },
        { "refId": "C", "expr": "histogram_quantile(0.95, sum by (le) (rate(reqcheck_embedder_request_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 запроса" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p95 запроса" }, "properties": [ { "id": "unit", "value": "s" }, { "id": "custom.axisPlacement", "value": "right" } ] },
          { "matcher": { "id": "byName", "options": "ошибки" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ] }
    },

    { "type": "row", "title": "Ресурсы", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 }, "panels": [] },
    {
      "type": "timeseries", "title": "CPU по сервисам, ядер",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"$project\"}[$__rate_interval]))", "legendFormat": "{{container_label_com_docker_compose_service}}" } ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2 } }
    },
    {
      "type": "timeseries", "title": "Память по сервисам (working set)",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_project=\"$project\"})", "legendFormat": "{{container_label_com_docker_compose_service}}" } ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "timeseries", "title": "Postgres: соединения и размер БД",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(pg_stat_database_numbackends{datname!~\"template.*\"})", "legendFormat": "соединения" },
        { "refId": "B", "expr": "sum(pg_database_size_bytes{datname!~\"template.*|postgres\"})", "legendFormat": "размер БД" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" },
        "overrides": [ { "matcher": { "id": "byName", "options": "размер БД" }, "properties": [ { "id": "unit", "value": "bytes" }, { "id": "custom.axisPlacement", "value": "right" } ] } ] }
    },
    {
      "type": "timeseries", "title": "Redis: память и клиенты",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(redis_memory_used_bytes)", "legendFormat": "память" },
        { "refId": "B", "expr": "max(redis_memory_max_bytes)", "legendFormat": "maxmemory" },
        { "refId": "C", "expr": "max(redis_connected_clients)", "legendFormat": "клиенты" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" },
        "overrides": [ { "matcher": { "id": "byName", "options": "клиенты" }, "properties": [ { "id": "unit", "value": "short" }, { "id": "custom.axisPlacement", "value": "right" } ] } ] }
    },

    { "type": "row", "title": "Логи", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 50 }, "panels": [] },
    {
      "type": "timeseries", "title": "Ошибки в логах по сервисам",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 51 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "expr": "sum by (service) (count_over_time({service=~\"$service\", level=~\"error|critical|fatal\"} [$__auto]))", "legendFormat": "{{service}}" } ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } } }
    },
    {
      "type": "logs", "title": "Логи контейнеров",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 58 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "expr": "{service=~\"$service\"}" } ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true, "dedupStrategy": "none" }
    }
  ]
}
